# Production image for the React SPA: build the bundle with Vite, then serve
# the static output from nginx.
FROM node:22-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json

RUN npm ci --workspace=apps/web --include-workspace-root

COPY apps/web apps/web

# Vite inlines VITE_* variables at build time, so the API URL and map key have
# to be known here rather than injected when the container starts.
ARG VITE_API_URL
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_DISABLE_GOOGLE_MAPS
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY \
    VITE_DISABLE_GOOGLE_MAPS=$VITE_DISABLE_GOOGLE_MAPS

RUN npm run build --workspace=apps/web

FROM nginx:1.27-alpine

COPY docker/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
