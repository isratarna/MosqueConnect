APP_NAME=MosqueConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://mosqueconnect.austattendance.online
FRONTEND_URL=http://mosqueconnect.austattendance.online
SANCTUM_STATEFUL_DOMAINS=mosqueconnect.austattendance.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=mosqueconnect_db
DB_USERNAME=mosqueconnect
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mosqueconnect.austattendance.online"
MAIL_FROM_NAME="${APP_NAME}"

OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_SEND_THROTTLE_PER_MINUTE=5
OTP_VERIFY_THROTTLE_PER_MINUTE=10
# "log" only writes OTPs to storage/logs; set a real SMS driver for real users
OTP_SMS_DRIVER=log

PRAYER_TIMEZONE=Asia/Dhaka
PRAYER_CALCULATION_METHOD=KARACHI
PRAYER_ASR_SCHOOL=HANAFI

CLAIM_AI_REVIEW_ENABLED=false
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_CREDENTIALS=

GEOAPIFY_API_KEY=
