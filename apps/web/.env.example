# Copy this file to ".env" and fill in your key.
# Vite exposes only variables prefixed with VITE_ to the app.

# Laravel API base URL
VITE_API_URL=http://localhost:8000

# Enable only after the event register/unregister API routes are available.
VITE_EVENT_REGISTRATION_ENABLED=false

# Google Maps JavaScript API key (https://console.cloud.google.com/)
VITE_GOOGLE_MAPS_API_KEY=
